# ==========================================
# CloudSubs - Git Ignore
# ==========================================

# Environment variables / secrets
.env
.env.*
!.env.example
backend/.env
frontend/.env

# Node dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production builds
dist/
frontend/dist/
backend/dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Coverage
coverage/